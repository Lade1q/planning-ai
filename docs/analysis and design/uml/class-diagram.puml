@startuml RecallAI-ClassDiagram
' =====================================================================
' Recall AI — Class Diagram (PlantUML source)
' SAD Section 4.x — Logical View / Class Diagrams. Fulfils issue #85 / I5.2.
' Extracted from actual source: src/server/src/**, src/client/src/**.
' Render a high-res image for the Word SAD:
'   - VS Code "PlantUML" extension  ->  Export (PNG/SVG), OR
'   - https://www.plantuml.com/plantuml  ->  paste  ->  PNG/SVG.
' Note: TypeScript back-end services/controllers are functional modules
'   (exported functions), modelled here as «module» classes with {static}
'   operations — this reflects the real design, not class instances.
' =====================================================================

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

' ============ External dependencies ============
package "External" <<Cloud>> {
  class PrismaClient <<external>> {
    +user
    +studyPlan
    +concept
    +conceptEdge
    +analysisJob
    +$transaction()
  }
  class GoogleGenAI <<external>> {
    +files
    +interactions
  }
}

' ============ Cross-cutting: errors, utils, middleware ============
package "Server · Cross-cutting" {
  class AppError extends Error {
    +message: string
    +statusCode: number
    +code?: string
    +constructor(message, statusCode, code?)
  }
  class ErrorHandler <<module>> {
    +{static} errorHandler(err, req, res, next)
    +{static} asyncHandler(fn): Handler
  }
  class AuthMiddleware <<module>> {
    +{static} authMiddleware(req, res, next): void
  }
  class UploadMiddleware <<module>> {
    -ALLOWED_MIMES: string[]
    -MAX_FILE_SIZE: number
    +{static} upload: Multer
  }
  class JwtUtil <<module>> {
    +{static} generateAccessToken(payload): string
    +{static} generateRefreshToken(payload): string
    +{static} verifyToken(token, secret): JwtPayload
  }
  interface JwtPayload {
    +userId: string
    +email: string
  }
  class DagUtil <<module>> {
    +{static} validateAndFixDag(nodeIds, edges): DagFixResult
  }
  interface GraphEdge {
    +from: string
    +to: string
  }
  interface DagFixResult {
    +edges: E[]
    +removedEdges: E[]
    +autoFixed: boolean
  }
}

' ============ API layer: controllers ============
package "Server · API Layer" {
  class AuthController <<controller>> {
    +{static} registerController(req, res): void
    +{static} loginController(req, res): void
    +{static} refreshController(req, res): void
    +{static} getMeController(req, res): void
  }
  class PlanController <<controller>> {
    -storageService: StorageService
    +{static} createPlanController(req, res): void
    +{static} listPlansController(req, res): void
    +{static} getPlanByIdController(req, res): void
  }
  class GraphController <<controller>> {
    +{static} updatePlanGraphController(req, res): void
  }
}

' ============ Service layer ============
package "Server · Service Layer" {
  class AuthService <<service>> {
    -SALT_ROUNDS: number
    +{static} register(data): AuthResponse
    +{static} login(data): AuthResponse
    +{static} refresh(data): RefreshResponse
    +{static} getMe(userId): UserResponse
  }
  class PlanService <<service>> {
    +{static} createPlanInDb(userId, planId, input, fileKey): CreatePlanResponse
    +{static} getUserPlans(userId): PlanItemResponse[]
    +{static} getPlanById(planId, userId): PlanDetailResponse
  }
  class GraphService <<service>> {
    +{static} validateDAG(planId): DagValidationResult
    +{static} replacePlanGraph(planId, userId, input): PlanGraphResponse
  }
  class AnalysisService <<service>> {
    -MAX_ATTEMPTS: number
    -BACKOFF_BASE_MS: number
    +{static} processAnalysisJob(jobId): void
    +{static} triggerAnalysis(planId): void
    -{static} callAi(fileKey): AiExtractResponse
    -{static} callAiWithRetry(fileKey): AiExtractResponse
    -{static} markFailed(jobId): void
  }
  class GeminiService <<service>> {
    -MODEL: string
    -SYSTEM_INSTRUCTION: string
    +{static} uploadFile(absolutePath, mimeType): FileRef
    +{static} extractConcepts(source): AiExtractResponse
    -{static} waitForFileActive(fileName): void
  }
  interface StorageService <<interface>> {
    +upload(localFilePath, destinationKey): string
    +delete(fileKey): void
  }
  class LocalStorageService {
    +upload(localFilePath, destinationKey): string
    +delete(fileKey): void
  }
  class StorageFactory <<factory>> {
    +{static} createStorageService(): StorageService
  }
  interface DagValidationResult {
    +isValid: boolean
    +removedEdges: EdgeItemResponse[]
  }
}

' ============ DTOs (response shapes) ============
package "Server · DTO" <<Rectangle>> {
  interface AuthResponse
  interface RefreshResponse
  interface UserResponse
  interface CreatePlanResponse
  interface PlanItemResponse
  interface PlanDetailResponse
  interface PlanGraphResponse
  interface ConceptItemResponse
  interface EdgeItemResponse
}

' ============ Client: Auth feature ============
package "Client · Auth Feature" {
  interface AuthContextValue <<interface>> {
    +user: User | null
    +isAuthenticated: boolean
    +isLoading: boolean
    +login(email, password): Promise
    +logout(): void
    +register(email, password, name): Promise
  }
  class AuthProvider <<component>> {
    -user: User | null
    -isLoading: boolean
    +login(email, password): Promise
    +logout(): void
    +register(email, password, name): Promise
  }
  class AuthContext <<React.Context>> {
  }
  class useAuth <<hook>> {
    +(): AuthContextValue
  }
  class AuthApi <<module>> {
    +{static} loginApi(data): AuthResponse
    +{static} registerApi(data): AuthResponse
  }
  class ApiClient <<singleton>> {
    -isRefreshing: boolean
    +interceptors.request
    +interceptors.response
    +get(url)
    +post(url, body)
  }
  class LoginForm <<component>> {
    -showPassword: boolean
    +onSubmit(data): Promise
    +render()
  }
  class SignupForm <<component>> {
    +onSubmit(data): Promise
    +render()
  }
  class ProtectedRoute <<component>> {
    +render()
  }
  class User <<DTO>> {
    +id: string
    +email: string
    +name: string | null
  }
  class ConceptGraph <<planned>> {
  }
  class PlanForm <<planned>> {
  }
}

' ==================== Relationships ====================

' Inheritance / realization
Error <|-- AppError
StorageService <|.. LocalStorageService
StorageFactory ..> LocalStorageService : creates
AuthProvider ..|> AuthContextValue : provides

' API -> Service (dependency injection via ES module import)
AuthController ..> AuthService
PlanController ..> PlanService
PlanController ..> AnalysisService
PlanController ..> StorageFactory
PlanController o--> StorageService
GraphController ..> GraphService

' Service -> data / util / external
AuthService ..> PrismaClient
AuthService ..> JwtUtil
PlanService ..> PrismaClient
GraphService ..> PrismaClient
GraphService ..> DagUtil
AnalysisService ..> GeminiService
AnalysisService ..> GraphService
AnalysisService ..> DagUtil
AnalysisService ..> PrismaClient
GeminiService ..> GoogleGenAI

' Cross-cutting usage
AuthMiddleware ..> JwtUtil
AuthMiddleware ..> AppError
AuthController ..> AppError
PlanController ..> AppError
GraphController ..> AppError
AuthService ..> AppError
GeminiService ..> AppError
JwtUtil ..> AppError
DagUtil ..> GraphEdge
DagUtil ..> DagFixResult
JwtUtil ..> JwtPayload

' Service -> DTO (returns)
AuthService ..> AuthResponse
PlanService ..> PlanDetailResponse
GraphService ..> PlanGraphResponse
GraphService ..> DagValidationResult

' Client wiring
AuthProvider *--> AuthContext : provides
useAuth ..> AuthContext : consumes
AuthProvider ..> AuthApi
AuthProvider ..> ApiClient
AuthApi ..> ApiClient
LoginForm ..> useAuth
SignupForm ..> useAuth
ProtectedRoute ..> useAuth
AuthApi ..> User

' Planned (not yet implemented) — CreatePlanPage is currently a placeholder
PlanForm ..> useAuth
ConceptGraph ..> ApiClient

@enduml
