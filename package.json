{
  "name": "planning-ai",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "src/client/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/server/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
