# Port for local backend server
PORT=3001

# Application environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database — Postgres dùng CHUNG trên Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Cả team trỏ vào MỘT database, nên không còn cảnh mỗi máy một phiên bản schema.
# Lấy chuỗi ở Supabase Dashboard → Connect → chọn **Session pooler**, rồi thay
# `[YOUR-PASSWORD]` bằng mật khẩu database (khác mật khẩu đăng nhập Supabase).
#
# Đừng chọn "Direct connection": Supabase chỉ cấp cho nó địa chỉ IPv6, mà mạng
# nhà và runner của GitHub Actions phần lớn chưa có IPv6 — sẽ treo ở ENETUNREACH
# chứ không báo lỗi rõ ràng.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Chỉ cần khi DATABASE_URL trỏ vào **transaction pooler** (cổng 6543): chế độ đó
# không giữ session nên advisory lock của `prisma migrate` không sống qua nổi.
# Khi có biến này, `prisma migrate` / `prisma db pull` dùng nó thay DATABASE_URL.
# Để trống nếu bạn đã dùng session pooler (5432) cho cả hai việc.
# DIRECT_URL=""

# Postgres chạy máy mình — KHÔNG dùng để phát triển hằng ngày nữa.
# Chỉ lôi ra khi cần tạo migration mới (xem README §5), vì `prisma migrate dev`
# phải tạo được shadow database, việc mà tài khoản Supabase qua pooler không làm được:
#   postgresql://postgres:postgrespassword@localhost:5432/recall_ai_dev?schema=public

# JWT Secret Keys (Must be at least 32 characters long)
JWT_SECRET="your_jwt_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Google Gemini AI API Key
GEMINI_API_KEY="insert_your_actual_gemini_api_key_here"

# Skip real Gemini calls and use fixed sample data (dev/test, avoids quota usage)
USE_MOCK_AI=false

# Model used for the extract_concepts call (I3.2)
# Use the rolling "-latest" alias, not a pinned dated name — Google retires
# dated model IDs for new API keys with little notice (confirmed 2026-07-25:
# gemini-2.5-flash and gemini-2.5-flash-lite both returned HTTP 404 "no
# longer available to new users" on a fresh free-tier key).
GEMINI_MODEL_EXTRACT="gemini-flash-latest"

# Model used for the generate_question / grade_answer calls (I6.2)
# Same "-latest" rule as above. These two run inside a live conversation, so latency
# matters more than depth — the service pins thinking_level to "low" for them.
GEMINI_MODEL_INTERVIEW="gemini-flash-latest"

# Upper bound (ms) on any single Gemini SDK call (files.get/upload, interactions.create).
# A hang past this becomes an AI_UNAVAILABLE error, which the existing AE-02 retry and
# AE-05 flashcard fallback already handle. Default has margin above the ~10-20s grading
# latency observed in production.
GEMINI_TIMEOUT_MS=30000
