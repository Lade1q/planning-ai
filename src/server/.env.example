# Port for local backend server
PORT=3001

# Application environment
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/recall_ai?schema=public"

# JWT Secret Keys (Must be at least 32 characters long)
JWT_SECRET="your_jwt_secret_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Google Gemini AI API Key
GEMINI_API_KEY="insert_your_actual_gemini_api_key_here"
